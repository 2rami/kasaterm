# 서울 관문 앞단 — nginx(443, SNI) 가 PROXY 프로토콜과 함께 넘긴 TLS 를 여기서 푼다. /etc/kasa-edge/Caddyfile.
{
	admin off
	email {$KASA_EDGE_CONTACT}
	# 역터널 웹 주소(sites/web.caddy)는 인증서를 첫 접속 때 받는다 — DNS 를 이 서버로 돌린 직후의 접속도 발급을 기다렸다
	# 붙어 끊기지 않고, 미리보기 이름은 그때그때 생긴다. 받아도 되는 이름인지는 아래 127.0.0.1:18899 가 답한다.
	on_demand_tls {
		ask http://127.0.0.1:18899/ask
	}
	# 80 은 iroh-relay(사로잡힌 포털 확인)가 쓴다 — HTTP 챌린지 없이 TLS-ALPN 만(443 → nginx → 9443).
	http_port 8081
	https_port 9443
	servers :9443 {
		# HTTP/3(UDP 9443)는 밖으로 안 열린다 — nginx 가 TCP 443 만 넘긴다.
		protocols h1 h2
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 127.0.0.1/32
			}
			tls
		}
	}
}

(gateway) {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	# 앱 재서명(설치 링크 등록)은 macOS 키체인이라 미니 관문에 남는다. latest 만 기기 토큰을 보므로 여기서.
	# 미니는 ssh 역터널(미니 launchd com.geono.kasa-seoul-tunnel)로 붙는다 — Cloudflare 터널(kasaterm-mini)
	# 경유는 서울(ICN)에서 미니 커넥터까지 0.5MB/s 라 설치 파일·LFS 가 느렸다. 역터널은 100MB/s 대.
	@mini_install {
		path /relay/install/*
		not path /relay/install/latest
	}
	handle @mini_install {
		reverse_proxy 127.0.0.1:18790 {
			header_up CF-Connecting-IP {remote_host}
			flush_interval -1
		}
	}
	handle /lfs/* {
		reverse_proxy 127.0.0.1:18794 {
			flush_interval -1
		}
	}
	handle {
		# 관문은 루프백 상대면 CF-Connecting-IP 를 접속자로 본다 — 접속자가 보낸 값을 덮어쓴다.
		reverse_proxy 127.0.0.1:8790 {
			header_up CF-Connecting-IP {remote_host}
			flush_interval -1
		}
	}
}

# on-demand 허가. 고정 이름은 /etc/kasa-edge/on-demand/<이름> 파일이 있으면(gateway.sh allow), 그 밖은 미니 미리보기
# 문지기가 등록 목록으로 답한다. DNS 를 이 서버로 돌리는 그때 허가한다 — 먼저 허가하면 누가 그 이름으로 여기 붙을 때
# 발급이 실패해 Let's Encrypt 실패 한도(이름당 시간 5회)를 먹는다.
http://127.0.0.1:18899 {
	bind 127.0.0.1
	@allowed file {
		root /etc/kasa-edge/on-demand
		try_files /{query.domain}
	}
	handle @allowed {
		respond 200
	}
	handle {
		rewrite * /__dp/ask
		reverse_proxy 127.0.0.1:18891
	}
}

# 사이트는 sites/ 에 하나씩 — 관문 주소(kasaterm)는 DNS 를 이 서버로 돌릴 때 넣는다. 먼저 넣으면 인증서 발급이
# 계속 실패해 Let's Encrypt 실패 한도(호스트당 시간 5회)에 걸린다.
import sites/*.caddy
