[Unit]
Description=kasaterm gateway (kasa-relay)
After=network-online.target
Wants=network-online.target

[Service]
User=kasa-relay
Group=kasa-relay
# 비밀(OAuth·GitHub 앱 등)은 여기에만 — gateway.sh env 가 미니 plist 에서 옮긴다.
EnvironmentFile=/etc/kasa-relay/env
Environment=HOME=/var/lib/kasa-relay
# 계정 기기의 카사넷 id 를 국내 중계 접근 확인이 읽는 자리에 내놓는다(gateway_kasanet.rs, tools/kasanet-relay/access.py).
Environment=KASA_RELAY_KASANET_ALLOW=/var/lib/kasanet-accounts/allowlist
ExecStart=/usr/local/bin/kasa-relay --bind 127.0.0.1 --port 8790 --state /var/lib/kasa-relay/relay-state.json
WorkingDirectory=/var/lib/kasa-relay
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kasa-relay /var/lib/kasanet-accounts
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
