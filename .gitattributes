# Windows CI 러너는 git core.autocrlf=true 라 체크아웃 시 텍스트가 CRLF 로 변환된다.
# collab-hooks 의 sh/py 는 MSI 로 번들돼 Git bash 에서 실행되므로 CRLF 면 shebang 부터
# 깨진다("\r: command not found") — LF 강제.
*.sh text eol=lf
*.py text eol=lf
# 시험 여럿이 include_str!("….rs") 로 소스를 읽어 "\n    }\n" 같은 줄 경계를 찾는다. rustc 는 CRLF 를
# 정규화하지만 include_str! 은 바이트 그대로라, CRLF 체크아웃에선 그 시험만 Windows 에서 깨진다.
*.rs text eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.ttc filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.icns filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.caf filter=lfs diff=lfs merge=lfs -text
