#!/bin/sh
# 판정 모델(Jev-Omni)에게 맡기는 카사크롬 명령. kc 와 같은 서버 코드·같은 기기 라우팅을 지나간다.
# PATH 에는 링크로 걸리므로 $0 의 링크를 끝까지 풀어야 레포를 옮겨도 따라온다.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
exec node "$(cd "$(dirname "$self")/.." && pwd)/mcp/server.mjs" --kj "$@"
